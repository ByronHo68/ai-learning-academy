# Optional: set this to the public URL after deploying your GitHub repository.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agent lab. npm run lab:setup generates .env.lab with random service secrets.
# npm run lab:start loads .env.lab into all three local processes.
# For an independently started Next.js server, copy the required proxy settings
# to .env.local. Never prefix these with NEXT_PUBLIC_.
AGENT_API_URL=http://127.0.0.1:8001
# LAB_AUTH_TOKEN=<random shared Next.js / FastAPI service token, 32+ characters>
# BANK_API_TOKEN=<random Python / Java service token, 32+ characters>
# BANK_APPROVAL_SECRET=<separate HMAC key, 32+ characters>
LAB_LOCAL_MODE=true
# For a private hosted lab: set LAB_LOCAL_MODE=false and a strong LAB_ACCESS_CODE.
# LAB_ACCESS_CODE=
# LAB_WEB_PORT=3000

# Live model: an OpenAI-compatible Chat Completions endpoint supporting strict
# JSON Schema output. Configure the exact model supported by your provider.
MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_API_KEY=
# MODEL_NAME=
# Cost estimates use YOUR configured rates (USD per million tokens).
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=

# Optional Langfuse Cloud or compatible self-hosted Langfuse v4 (Python SDK v5).
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# BANK_MCP_URL=http://127.0.0.1:8081/mcp
